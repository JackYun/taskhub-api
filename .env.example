# Copy to `.env` and adjust. `.env` is git-ignored – never commit real secrets.

# SQLite database (file is created if missing). In-memory: sqlite::memory:
DATABASE_URL=sqlite://taskhub.db

# Listen address. BIND_ADDR (e.g. 0.0.0.0:3000) overrides HOST/PORT.
HOST=127.0.0.1
PORT=3000

# HS256 signing secret – use a long random value (>= 32 bytes), e.g.
#   openssl rand -base64 48
# Required for release builds; debug builds fall back to an insecure dev key.
JWT_SECRET=replace-me-with-a-long-random-secret

# Access-token lifetime in seconds (default 3600 = 1 hour).
JWT_EXPIRY_SECONDS=3600

# Comma-separated allowed CORS origins; empty or * = any origin.
CORS_ALLOWED_ORIGINS=*

# Log filter (tracing-subscriber EnvFilter syntax).
RUST_LOG=taskhub_api=info,tower_http=info
